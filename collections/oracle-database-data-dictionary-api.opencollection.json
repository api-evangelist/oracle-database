      },
      "items": [
        {
          "info": {
            "name": "Oracle Database Get all tables",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://database.{region}.oraclecloud.com/20160918/database/objects/tables/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of items to skip before returning results"
              }
            ]
          },
          "docs": "Returns metadata for all database tables accessible to the current user."
        },
        {
          "info": {
            "name": "Oracle Database Get a specific table",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://database.{region}.oraclecloud.com/20160918/database/objects/tables/:owner,:table_name",
            "params": [
              {
                "name": "owner",
                "value": "",
                "type": "path"
              },
              {
                "name": "table_name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns metadata for a specific database table."
