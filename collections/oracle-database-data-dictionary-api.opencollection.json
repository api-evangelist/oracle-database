{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle Database Oracle Cloud Infrastructure Database APEX Data Dictionary API",
    "version": "20160918"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
